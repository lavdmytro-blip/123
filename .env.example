# Railway: set BOT_TOKEN and PUBLIC_BASE_URL, all other options optional
BOT_TOKEN=
PUBLIC_BASE_URL=https://YOUR-APP.up.railway.app
WEBHOOK_SECRET=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./signals.db
REDIS_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
BINGX_BASE_URL=https://open-api.bingx.com
BINGX_FALLBACK_URL=https://open-api.bingx.pro
ENABLE_WORKER=true
MAX_SCAN_WATCHES=20

AUTO_SIGNALS_ENABLED=true
# Scan all qualified instruments; the BALANCED filter always applies, even with ALL.
AUTO_SIGNALS_UNIVERSE=ALL
MARKET_FILTER_MODE=balanced
MARKET_MIN_24H_USDT=10000000
MARKET_MIN_LISTING_DAYS=30
MARKET_EXCLUDE_NONSTANDARD=true
# For a custom universe only, set CUSTOM and define AUTO_SIGNALS_SYMBOLS.
AUTO_SIGNALS_SYMBOLS=BTC-USDT,ETH-USDT,SOL-USDT,XRP-USDT,BNB-USDT
AUTO_SIGNALS_INTERVAL=15m
AUTO_SCAN_BATCH_SIZE=12
AUTO_SCAN_PACE_SECONDS=1.2
AUTO_SCAN_COOLDOWN_SECONDS=60

# v1.3: PUMP / DUMP observation + explicit private chat opt-in
PUMP_MONITOR_ENABLED=true
PUMP_POLL_SECONDS=20
PUMP_THRESHOLD_PERCENT=3.0
PUMP_VOLUME_MULTIPLIER=2.0
PUMP_MIN_TURNOVER_USDT=20000
PUMP_MIN_24H_USDT=100000
PUMP_COOLDOWN_MINUTES=30

# v1.4 Paper Trading: no new Railway variables needed.
# Uses existing ENABLE_WORKER=true / AUTO_SIGNALS_ENABLED=true.
# 1000 demo USDT, fees and risk caps configured server-side in config.py.
# NO BINGX PRIVATE API KEY, NO EXCHANGE TRADE PERMISSION.
